# Vorlage für die .env-Datei auf dem Hetzner-Server (liegt dort neben docker-compose.yml).
# Kopieren nach ".env" und Werte anpassen. Diese Datei NICHT ins Git-Repo committen.

# Domain, für die Caddy automatisch ein Let's-Encrypt-Zertifikat bezieht
DOMAIN=simply-cool.ch

# Beliebiges starkes Passwort für den Postgres-Datenbankbenutzer
POSTGRES_PASSWORD=

# Beliebiger langer Zufallsstring zur Signierung der Session-Cookies
# Erzeugen z.B. mit: openssl rand -hex 32
SESSION_SECRET=

# Hinweis: SMTP-Zugangsdaten und die Admin-Benachrichtigungs-E-Mail-Adresse werden
# NICHT über Umgebungsvariablen gesetzt, sondern direkt in der App unter
# Einstellungen -> "E-Mail-Versand (SMTP)" bzw. "Admin-E-Mail für neue Website-Leads"
# hinterlegt (dort in der Datenbank gespeichert).
